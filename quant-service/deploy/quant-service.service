[Unit]
Description=Codes123 quant monitoring service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=quant-service
Group=quant-service
WorkingDirectory=/opt/1panel/apps/codes123/quant-service
EnvironmentFile=-/etc/codes123/quant-service.env
Environment=HTTP_ADDR=127.0.0.1:18188
Environment=DATA_DIR=/var/lib/quant-service/data
ExecStart=/opt/1panel/apps/codes123/quant-service/quant-service
Restart=always
RestartSec=5s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/quant-service

[Install]
WantedBy=multi-user.target
