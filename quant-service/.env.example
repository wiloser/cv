OKX_BASE_URL=https://www.okx.com
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_SIMULATED_TRADING=false

OKX_INST_ID=BTC-USDT
OKX_INST_TYPE=SPOT
OKX_BAR=1D
OKX_CANDLE_LIMIT=300
EMA_PERIODS=12,26
OKX_ACCOUNT_CCY=USDT
BILLS_LOOKBACK=24h

BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_FEE_RATE=0.001
BACKTEST_SLIPPAGE_RATE=0.0005

SYNC_INTERVAL=24h
SYNC_ON_START=true
HTTP_ADDR=:8081
# SQLite database is created at DATA_DIR/quant.db; embedded schema migrations run on startup.
DATA_DIR=./data
CORS_ORIGIN=http://localhost:5174

# Gmail SMTP: use a Google app password, not the normal Gmail login password.
# Port 465 uses implicit TLS; port 587 uses STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional proxy. Supports HTTP CONNECT and SOCKS5/SOCKS5H.
# Examples: http://127.0.0.1:7890 or socks5://127.0.0.1:7891
SMTP_PROXY=
